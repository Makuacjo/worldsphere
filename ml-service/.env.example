# Server-only configuration. Copy to ml-service/.env for local use; never commit it.
DATABASE_URL=postgresql://worldsphere:local-password@localhost:5432/worldsphere
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional exact origins.
CORS_ORIGINS=
APP_URL=http://localhost:5173
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_PER_MINUTE=10
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_RATE_LIMIT_PER_MINUTE=20
